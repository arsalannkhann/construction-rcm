# The mobile app (mobile/, docs/mobile.md) is built separately and is not part
# of the website deployment. Patterns are anchored with a leading "/": a bare
# "mobile" also matches src/app/api/mobile and drops the mobile API.
/mobile/*
# Except the app's plain helpers in mobile/src/lib: tests import some of them
# (tests/mobile-*.test.ts), and `next build` type-checks the tests.
!/mobile/src/
/mobile/src/*
!/mobile/src/lib/
