# ── Core ─────────────────────────────────────────────────────────────────────
# Public base URL of this deployment (used in invite links and OAuth redirects).
APP_URL=http://localhost:3000

# 32+ random bytes, base64 or hex. Encrypts stored integration tokens.
# Required in production; a development key is derived automatically otherwise.
RCM_SECRET_KEY=

# Where the embedded database and uploaded documents live when DATABASE_URL is
# not set. Defaults to ./.data
RCM_DATA_DIR=

# Set to use a real PostgreSQL server instead of the embedded database.
# Required for a pilot or production. Documents are then stored in the database
# too, so one pg_dump backs up everything. See docs/operations.md.
DATABASE_URL=
# Connections per app process (default 10). On Supabase keep it below the
# pooler's pool size (Database settings → Connection pooling); 5 is plenty.
DATABASE_POOL_MAX=
# TLS for a database whose certificate is signed by the provider's own
# authority, as Supabase's is: the CA certificate in PEM form (one line with \n
# is fine) or the path to the .crt file. Connections are then encrypted and the
# server is verified, whatever DATABASE_URL says about sslmode.
DATABASE_CA_CERT=
# "external" when something other than the app applies the migrations: on
# Supabase, the GitHub integration applying supabase/migrations. The app then
# only checks at start that the schema is up to date. Unset: the app applies
# drizzle/ itself.
RCM_MIGRATIONS=

# ── AI document understanding (optional) ────────────────────────────────────
# Without a key the deterministic text-layer parser is used; scanned documents
# then have to be keyed by hand in the review workspace.
ANTHROPIC_API_KEY=
RCM_EXTRACTION_MODEL=

# ── Procore (optional) ───────────────────────────────────────────────────────
# OAuth app credentials from the Procore Developer Portal.
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=
# "production" or "sandbox"
PROCORE_ENV=sandbox

# ── Outbound email (optional) ────────────────────────────────────────────────
# Without these, messages to subcontractors are drafted and logged but not sent.
RESEND_API_KEY=
EMAIL_FROM=

# ── Inbound email (optional) ─────────────────────────────────────────────────
# Shared secret your email provider must send when posting to
# /api/inbound/email/<org intake token>: as the HTTP basic-auth password
# (preferred), an x-inbound-secret header, a Bearer token, or ?secret=
INBOUND_EMAIL_SECRET=
